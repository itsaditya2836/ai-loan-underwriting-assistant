GEMINI_API_KEY=
DATABASE_URL=sqlite:///./loan_underwriting.db
APP_ENV=development
LOG_LEVEL=INFO

# --- Stage 7/8: Authentication & Secrets (OVERRIDE IN PRODUCTION) ---
# Generate high-entropy 32+ byte secret in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=DEV-ONLY-INSECURE-SECRET-CHANGE-IN-PRODUCTION
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-loan-underwriting-assistant
JWT_AUDIENCE=underwriting-api
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=10
DEFAULT_ADMIN_PASSWORD=admin-dev-password-change-me

# --- Stage 7/8: Database Pooling, CORS & Streamlit Auth ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
STREAMLIT_AUTH_REQUIRED=false
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
