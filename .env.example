GEMINI_API_KEY=
DATABASE_URL=sqlite:///./loan_underwriting.db
APP_ENV=development
LOG_LEVEL=INFO

# --- Stage 7: Authentication & Secrets (OVERRIDE IN PRODUCTION) ---
# Set a high-entropy 32+ byte random secret in production environments
JWT_SECRET_KEY=DEV-ONLY-INSECURE-SECRET-CHANGE-IN-PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=10
DEFAULT_ADMIN_PASSWORD=admin-dev-password-change-me

# --- Stage 7: Database Pooling & Optional Streamlit Login Gate ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false
STREAMLIT_AUTH_REQUIRED=false
