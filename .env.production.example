# Example Production Configuration Template (NO REAL SECRETS OR CREDENTIALS)
# Replace all placeholder values using a secrets manager before starting services.

APP_ENV=production
LOG_LEVEL=INFO

# Target PostgreSQL database (requires installing psycopg or psycopg2-binary)
DATABASE_URL=postgresql+psycopg://underwriting_app:<REPLACE_WITH_DB_PASSWORD>@db.internal:5432/loan_underwriting
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# High-entropy random JWT secret (minimum 32 characters; startup fails closed otherwise)
JWT_SECRET_KEY=<REPLACE_WITH_MINIMUM_32_BYTE_RANDOM_SECRET>
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-loan-underwriting-assistant
JWT_AUDIENCE=underwriting-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate limiting & lockout thresholds
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
MAX_FAILED_LOGIN_ATTEMPTS=10

# Must NOT retain the dev default; initial production admin should be provisioned via secure CLI/API
DEFAULT_ADMIN_PASSWORD=<REPLACE_WITH_UNIQUE_ADMIN_CREDENTIAL_OR_UNUSED_RANDOM_STRING>

# Always enforced automatically when APP_ENV=production
STREAMLIT_AUTH_REQUIRED=true

# Explicit frontend origins allowed to access FastAPI (never '*' in production)
CORS_ALLOWED_ORIGINS=https://underwriting.example.com

# Optional external integration key (deterministic local agents remain authoritative)
GEMINI_API_KEY=
